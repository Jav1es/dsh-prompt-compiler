{
  "name": "dsh-prompt-compiler",
  "version": "0.1.0",
  "description": "Prompt Compiler 插件：把粗糙 draft 编译成结构化 prompt（DSH 插件 host 半，B 组最小可运行版）。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "prompt-engineering",
    "prompt-compiler"
  ],
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/sdk.js && node --check lib/service.js && node --check lib/client.js",
    "prepare": "node -e \"1\""
  },
  "main": "lib/index.js",
  "types": "lib/types.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./types": "./lib/types.d.ts",
    "./service": "./lib/service.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "engines": {
    "dsh": "^0.2.0-rc.2",
    "node": "^22.19.0 || >=24"
  },
  "license": "MIT"
}
