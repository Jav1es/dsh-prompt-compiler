{
  "name": "dsh-prompt-compiler",
  "version": "0.4.1",
  "description": "Prompt Compiler 插件：把粗糙 draft 编译成结构化 prompt（DSH 插件 host 半，B 组最小可运行版）。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "cordis",
    "plugin",
    "prompt-engineering",
    "prompt-compiler"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jav1es/dsh-prompt-compiler.git"
  },
  "homepage": "https://github.com/Jav1es/dsh-prompt-compiler#readme",
  "bugs": {
    "url": "https://github.com/Jav1es/dsh-prompt-compiler/issues"
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/sdk.js && node --check lib/service.js && node --check lib/settings.js && node --check lib/templates.js && node --check lib/builtin-templates.js && node --check lib/scoring.js && node --check lib/auto-mode.js && node --check lib/client.js && node --check evals/run.cjs && node --check scripts/verify-static.cjs && node --check scripts/verify-e2e.cjs && node --check scripts/verify-prompt.cjs",
    "test": "node --test \"tests/**/*.test.js\"",
    "eval": "node evals/run.cjs",
    "verify:static": "node scripts/verify-static.cjs",
    "verify:unit": "npm run check && npm test",
    "verify:e2e": "node scripts/verify-e2e.cjs",
    "verify": "npm run verify:static && npm run verify:unit && npm run verify:prompt && npm run verify:e2e",
    "verify:all": "npm run verify && npm run eval",
    "prepublishOnly": "npm run verify",
    "prepare": "node -e \"1\"",
    "verify:prompt": "node scripts/verify-prompt.cjs"
  },
  "main": "lib/index.js",
  "types": "lib/types.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./types": "./lib/types.d.ts",
    "./service": "./lib/service.js",
    "./settings": "./lib/settings.js",
    "./templates": "./lib/templates.js",
    "./scoring": "./lib/scoring.js",
    "./auto-mode": "./lib/auto-mode.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "engines": {
    "dsh": "^0.2.0-rc.2",
    "node": "^22.19.0 || >=24"
  },
  "license": "MIT"
}
